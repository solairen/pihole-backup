{
  "name": "pihole backup",
  "dockerFile": "../docker/Dockerfile-dev",
  "postCreateCommand": "echo DONE! && export PATH=$PATH:/home/ubuntu/.local/bin",
  "workspaceMount": "source=${localWorkspaceFolder},target=/development,type=bind",
  "workspaceFolder": "/development",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gnupg,target=/home/ubuntu/.gnupg,type=bind,consistency=cached"
  ],
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "remoteEnv": {
    "AZURE_TELEMETRY_DISABLED": "true",
    "PIHOLE_PASSWORD": "${localEnv:PIHOLE_PASSWORD}",
    "S3_ACCESS_KEY": "${localEnv:S3_ACCESS_KEY}",
    "S3_SECRET_KEY": "${localEnv:S3_SECRET_KEY}",
    "AZURE_CLIENT_ID": "${localEnv:AZURE_CLIENT_ID}",
    "AZURE_TENANT_ID": "${localEnv:AZURE_TENANT_ID}",
    "AZURE_CLIENT_SECRET": "${localEnv:AZURE_CLIENT_SECRET}",
    "AZURE_SUBSCRIPTION_ID": "${localEnv:SUBSCRIPTION_ID}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          }
        }
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.remotehub",
        "GitHub.vscode-github-actions",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",
        "formulahendry.dotnet-test-explorer",
        "ms-dotnettools.vscode-dotnet-pack",
        "adrianwilczynski.namespace",
        "jesschadwick.nuget-reverse-package-search",
        "josefpihrt-vscode.roslynator",
        "ybaumes.highlight-trailing-white-spaces",
        "Gruntfuggly.todo-tree",
        "aaron-bond.better-comments",
        "docsmsft.docs-preview",
        "docsmsft.docs-markdown",
        "eamodio.gitlens",
        "VisualStudioExptTeam.vscodeintellicode",
        "ms-vscode.powershell",
        "Anthropic.claude-code"
      ]
    }
  }
}
